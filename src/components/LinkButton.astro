---
import Icon from './Icon.astro';

export interface Props {
  href: string;
  text: string;
  iconName?: string;
}
const { href, text, iconName } = Astro.props;

// Upewnij się, że linki zewnętrzne (zaczynające się od http) nie są modyfikowane
const finalHref = href.startsWith('http') ? href : `${import.meta.env.BASE_URL.slice(0, -1)}${href}`;
---
<a href={finalHref} target="_blank" rel="noopener noreferrer" class="cv-button">
  {iconName && <Icon name={iconName} />}
  <span>{text}</span>
</a>